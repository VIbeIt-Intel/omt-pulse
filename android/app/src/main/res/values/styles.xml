<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme.
         Window background stays dark so Capacitor map punch-through (transparent
         WebView holes) never flash the default Light theme white while the native
         MapView is creating or when Live Incident chrome is intentionally transparent. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/omt_window_background</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/omt_window_background</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>

    <style name="FireAlertTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#0c100e</item>
        <item name="android:statusBarColor">#0c100e</item>
        <item name="android:navigationBarColor">#0c100e</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="PanicAlertTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#1a0a0c</item>
        <item name="android:statusBarColor">#1a0a0c</item>
        <item name="android:navigationBarColor">#1a0a0c</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="RadioAlertTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#0c100e</item>
        <item name="android:statusBarColor">#0c100e</item>
        <item name="android:navigationBarColor">#0c100e</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="CrimeAlertTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#101418</item>
        <item name="android:statusBarColor">#101418</item>
        <item name="android:navigationBarColor">#101418</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="ChatAlertTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#0c100e</item>
        <item name="android:statusBarColor">#0c100e</item>
        <item name="android:navigationBarColor">#0c100e</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>