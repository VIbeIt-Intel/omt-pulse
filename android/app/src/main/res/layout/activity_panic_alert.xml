<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panic_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a0a0c"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="64dp"
    android:paddingEnd="20dp"
    android:paddingBottom="28dp">

    <TextView
        android:id="@+id/panic_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="56sp" />

    <TextView
        android:id="@+id/panic_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#B3FFFFFF"
        android:textSize="16sp" />

    <LinearLayout
        android:id="@+id/panic_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:background="@drawable/bg_panic_card"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_panic_icon"
                android:gravity="center"
                android:text="!"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Wagtoring"
                android:textColor="#3F3F46"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="nou"
                android:textColor="#71717A"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/panic_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#18181B"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/panic_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#3F3F46"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/panic_open"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_panic_open"
        android:gravity="center"
        android:text="Gaan na die paniek"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/panic_details"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_panic_details"
        android:gravity="center"
        android:text="Sien die paniek"
        android:textColor="#18181B"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
